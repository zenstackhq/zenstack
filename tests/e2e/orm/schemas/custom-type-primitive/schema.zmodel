datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
    id       String    @id @default(nanoid())
    name     UserName
    contacts Contact[]
    age      Age?      @default(18)
    posts    Post[]
}

model Post {
    id       String    @id @default(nanoid())
    authorId String
    author   User      @relation(fields: [authorId], references: [id])
    tags     PostTag[] @length(2, 3)
}

type UserName with String {
    this String @length(2, 16)
}

type Contact with String {
    this String @phone
}

type Age with Int {
    this Int @gte(18)
}

type PostTag with String {
    this String @length(1, 12)
}
