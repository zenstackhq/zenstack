datasource db {
    provider = 'sqlite'
}

model User {
    id        String   @id @default(cuid())
    email     String   @unique
    name      String?
    posts     Post[]
    createdAt DateTime @default(now())
}

model Post {
    id       String  @id @default(cuid())
    title    String
    author   User?   @relation(fields: [authorId], references: [id])
    authorId String?
}

type Notification {
    message String

    @@strict
}

procedure getStats(): Int

mutation procedure sendNotification(notification: Notification): Boolean
