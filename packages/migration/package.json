{
    "name": "@zenstackhq/migration",
    "displayName": "ZenStack Migration Engine",
    "description": "Native database schema migration engine for ZenStack, built on Kysely.",
    "version": "3.8.3",
    "type": "module",
    "author": {
        "name": "ZenStack Team",
        "email": "contact@zenstack.dev"
    },
    "homepage": "https://zenstack.dev",
    "repository": {
        "type": "git",
        "url": "https://github.com/zenstackhq/zenstack"
    },
    "license": "MIT",
    "scripts": {
        "build": "tsc --noEmit && tsdown",
        "watch": "tsdown --watch",
        "lint": "eslint src --ext ts",
        "pack": "pnpm pack"
    },
    "keywords": [
        "orm",
        "migration",
        "database",
        "kysely"
    ],
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./package.json": "./package.json"
    },
    "dependencies": {
        "@zenstackhq/orm": "workspace:*",
        "@zenstackhq/schema": "workspace:*",
        "kysely": "catalog:"
    },
    "devDependencies": {
        "@types/better-sqlite3": "catalog:",
        "@types/node": "catalog:",
        "@types/pg": "^8.16.0",
        "@zenstackhq/eslint-config": "workspace:*",
        "@zenstackhq/tsdown-config": "workspace:*",
        "@zenstackhq/typescript-config": "workspace:*"
    },
    "peerDependencies": {
        "better-sqlite3": "catalog:",
        "mysql2": "catalog:",
        "pg": "catalog:"
    },
    "peerDependenciesMeta": {
        "better-sqlite3": {
            "optional": true
        },
        "mysql2": {
            "optional": true
        },
        "pg": {
            "optional": true
        }
    },
    "funding": "https://github.com/sponsors/zenstackhq"
}
