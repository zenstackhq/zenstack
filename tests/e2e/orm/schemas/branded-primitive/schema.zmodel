datasource db {
    provider = "sqlite"
    url      = "file:./dev.db"
}

model User {
    id    UserId  @id
    email Email   @unique
    name  String?
    age   Age?
    posts Post[]
}

model Post {
    id       PostId @id
    title    String
    authorId UserId
    author   User   @relation(fields: [authorId], references: [id])
}

type UserId with String {
    this String

    @@validate(startsWith(this, 'user_'))
    @@branded
}

type PostId with String {
    this String

    @@validate(startsWith(this, 'post_'))
    @@branded
}

type Email with String {
    this String @email
    @@branded
}

type Age with Int {
    this Int @gte(0)
    @@branded
}
